{
  "name": "scrap-ui-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run build",
    "start": "ng serve demo",
    "build": "ng build scrap-ui && node scripts/build-css.mjs",
    "watch": "ng build scrap-ui --watch --configuration development",
    "build:demo": "ng build demo",
    "test": "npm run test:lib && npm run test:demo && npm run test:schematics",
    "test:lib": "ng test scrap-ui --watch=false",
    "test:demo": "ng test demo --watch=false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "visual": "playwright test",
    "visual:update": "playwright test --update-snapshots",
    "visual:report": "playwright show-report",
    "verify": "npm run lint && npm run format:check && npm run build && npm run test && npm run visual",
    "test:schematics": "vitest run --config vitest.schematics.config.ts"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "sass": "^1.101.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.8"
  }
}
