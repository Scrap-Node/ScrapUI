{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/scrap-ui",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    {
      "input": "src/styles",
      "glob": "**/*.scss",
      "output": "styles"
    },
    {
      "input": "assets",
      "glob": "**/*",
      "output": "assets"
    },
    {
      "input": "schematics",
      "glob": "**/*",
      "output": "schematics"
    },
    {
      "input": ".",
      "glob": "LICENSE",
      "output": "."
    },
    {
      "input": ".",
      "glob": "NOTICE",
      "output": "."
    },
    {
      "input": ".",
      "glob": "CHANGELOG.md",
      "output": "."
    }
  ]
}
