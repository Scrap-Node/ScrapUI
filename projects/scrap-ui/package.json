{
  "name": "@scrapnode/scrap-ui",
  "version": "0.4.0",
  "description": "Bibliothèque d'interface des projets Scrap Node : jetons, composants Angular et feuille CSS sans framework",
  "author": "comeChaslerie",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scrap-Node/ScrapUI.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "schematics": "./schematics/collection.json",
  "peerDependencies": {
    "@angular/common": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": false,
  "exports": {
    "./styles/*": {
      "sass": "./styles/*",
      "default": "./styles/*"
    },
    "./css/*": {
      "default": "./css/*"
    },
    "./assets/*": {
      "default": "./assets/*"
    }
  }
}
